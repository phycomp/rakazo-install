# Railway / Rakazo environment variables (copy to .env and fill in real values)

# Required (auto-generated by Railway — do not edit manually)
BETTER_AUTH_SECRET=
ENCRYPTION_KEY=
SCREEN_PROXY_SECRET=
POSTGRES_PASSWORD=
DATABASE_URL=

# Model provider (recommended)
OPENROUTER_API_KEY=

# Sandbox provider (choose one: e2b | daytona | box | none)
SANDBOX_PROVIDER=e2b
E2B_API_KEY=
# DAYTONA_API_KEY=
# BOX_API_KEY=

# Access control (set before first API start)
SIGNUP_ALLOWLIST=

# Optional email
SMTP_URL=
EMAIL_FROM=

# Optional integrations
COMPOSIO_API_KEY=
